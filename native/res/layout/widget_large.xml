<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/dd_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher" android:contentDescription="Pix"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="DailyDally" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/w_streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔥 0" android:textColor="#FFFF9600" android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Open DailyDally to start" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_unit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Unit 1" android:textColor="#FF9AA0AB" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Lesson 1" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/w_mins" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="30 min" android:textColor="#FF9AA0AB" android:textSize="12sp"/>
    <ProgressBar android:id="@+id/w_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp"
        android:max="100" android:progress="0" android:progressDrawable="@drawable/dd_widget_progress"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_pct" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="0/48 lessons" android:textColor="#FF9AA0AB" android:textSize="12sp"/>
        <TextView android:id="@+id/w_xp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚡ 0 XP" android:textColor="#FFFCE42A" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/w_cta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="@drawable/dd_widget_cta" android:gravity="center"
        android:padding="10dp" android:text="Start lesson ›" android:textColor="#FF1A1700" android:textSize="15sp" android:textStyle="bold"/>
</LinearLayout>
