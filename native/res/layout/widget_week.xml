<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/l0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Mon" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Tue" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Wed" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Thu" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Fri" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Sat" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
        <TextView android:id="@+id/l6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="Sun" android:textColor="#FFF2F1EC" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c0" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c1" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c2" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c3" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c4" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c5" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:id="@+id/c6" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="center"
                android:background="@drawable/dd_day_future" android:gravity="center" android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold"/>
        </FrameLayout>
    </LinearLayout>
    <TextView android:id="@+id/w_line" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:textColor="#FFF2F1EC" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
    <TextView android:id="@+id/w_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:textSize="14sp" android:textStyle="bold" android:shadowColor="#99000000" android:shadowRadius="4" android:shadowDy="1"/>
</LinearLayout>
